{
  "schemaVersion": "1.0.0.0",
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "To": {
              "type": "string"
            },
            "Cc": {
              "type": "string"
            },
            "Subject": {
              "type": "string"
            },
            "BodyHtml": {
              "type": "string"
            }
          },
          "required": [
            "To",
            "Subject",
            "BodyHtml"
          ]
        }
      }
    }
  },
  "actions": {
    "Get_Shared_Mailbox": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadappconfigs",
          "$filter": "enmax_acdnkey eq 'SharedMailboxAddress'",
          "$top": 1
        }
      }
    },
    "Compose_Mailbox": {
      "type": "Compose",
      "runAfter": {
        "Get_Shared_Mailbox": [
          "Succeeded"
        ]
      },
      "inputs": "@{coalesce(outputs('Get_Shared_Mailbox')?['body/value'][0]?['enmax_acdnvalue'], '')}"
    },
    "Condition_Mailbox_Configured": {
      "type": "If",
      "runAfter": {
        "Compose_Mailbox": [
          "Succeeded"
        ]
      },
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
                "@trim(outputs('Compose_Mailbox'))",
                ""
              ]
            }
          },
          {
            "not": {
              "equals": [
                "@trim(coalesce(triggerBody()?['To'], ''))",
                ""
              ]
            }
          }
        ]
      },
      "actions": {
        "Send_Email": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SharedMailboxSendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/MailboxAddress": "@{outputs('Compose_Mailbox')}",
              "emailMessage/To": "@{triggerBody()?['To']}",
              "emailMessage/Cc": "@{coalesce(triggerBody()?['Cc'], '')}",
              "emailMessage/Subject": "@{triggerBody()?['Subject']}",
              "emailMessage/Body": "@{triggerBody()?['BodyHtml']}",
              "emailMessage/Importance": "Normal"
            }
          },
          "retryPolicy": {
            "type": "fixed",
            "count": 1,
            "interval": "PT30S"
          }
        }
      },
      "else": {
        "actions": {
          "Terminate_Missing_Config": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "SharedMailboxOrRecipientMissing",
                "message": "SharedMailboxAddress App Config is empty or To recipient is missing. Set SharedMailboxAddress and ensure the parent flow resolved a recipient."
              }
            }
          }
        }
      }
    },
    "Respond_to_Parent": {
      "type": "Response",
      "kind": "PowerApp",
      "runAfter": {
        "Condition_Mailbox_Configured": [
          "Succeeded",
          "Failed",
          "TimedOut",
          "Skipped"
        ]
      },
      "inputs": {
        "statusCode": 200,
        "body": {
          "ok": true
        },
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
