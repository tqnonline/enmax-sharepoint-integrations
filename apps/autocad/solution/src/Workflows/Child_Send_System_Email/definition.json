{
  "schemaVersion": "1.0.0.0",
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "To": {
              "type": "string"
            },
            "Cc": {
              "type": "string"
            },
            "Subject": {
              "type": "string"
            },
            "BodyHtml": {
              "type": "string"
            }
          },
          "required": [
            "To",
            "Subject",
            "BodyHtml"
          ]
        }
      }
    }
  },
  "actions": {
    "Initialize_CorrelationId": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": {
        "variables": [
          {
            "name": "CorrelationId",
            "type": "string",
            "value": "@{coalesce(triggerBody()?['CorrelationId'], guid())}"
          }
        ]
      }
    },
    "Initialize_FlowDisplayName": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialize_CorrelationId": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "FlowDisplayName",
            "type": "string",
            "value": "Enmax AutoCAD | Internal | Send System Email From Shared Mailbox"
          }
        ]
      }
    },
    "Initialize_FlowRunUrlTemplate": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialize_FlowDisplayName": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "FlowRunUrlTemplate",
            "type": "string",
            "value": "https://make.powerautomate.com/environments/{environmentId}/flows/{flowId}/runs/{runId}"
          }
        ]
      }
    },
    "Scope_Try_Main": {
      "type": "Scope",
      "runAfter": {
        "Initialize_FlowRunUrlTemplate": [
          "Succeeded"
        ]
      },
      "actions": {
        "Get_Shared_Mailbox": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadappconfigs",
              "$filter": "enmax_acdnkey eq 'SharedMailboxAddress'",
              "$top": 1
            }
          }
        },
        "Compose_Mailbox": {
          "type": "Compose",
          "runAfter": {
            "Get_Shared_Mailbox": [
              "Succeeded"
            ]
          },
          "inputs": "@{coalesce(outputs('Get_Shared_Mailbox')?['body/value'][0]?['enmax_acdnvalue'], '')}"
        },
        "Condition_Mailbox_Configured": {
          "type": "If",
          "runAfter": {
            "Compose_Mailbox": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@trim(outputs('Compose_Mailbox'))",
                    ""
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@trim(coalesce(triggerBody()?['To'], ''))",
                    ""
                  ]
                }
              }
            ]
          },
          "actions": {
            "Send_Email": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@{outputs('Compose_Mailbox')}",
                  "emailMessage/To": "@{triggerBody()?['To']}",
                  "emailMessage/Cc": "@{coalesce(triggerBody()?['Cc'], '')}",
                  "emailMessage/Subject": "@{triggerBody()?['Subject']}",
                  "emailMessage/Body": "@{triggerBody()?['BodyHtml']}",
                  "emailMessage/Importance": "Normal"
                }
              },
              "retryPolicy": {
                "type": "fixed",
                "count": 1,
                "interval": "PT30S"
              }
            }
          },
          "else": {
            "actions": {
              "Terminate_Missing_Config": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "SharedMailboxOrRecipientMissing",
                    "message": "SharedMailboxAddress App Config is empty or To recipient is missing. Set SharedMailboxAddress and ensure the parent flow resolved a recipient."
                  }
                }
              }
            }
          }
        }
      }
    },
    "Scope_Catch_Failure": {
      "type": "Scope",
      "runAfter": {
        "Scope_Try_Main": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Compose_Error_Context": {
          "type": "Compose",
          "runAfter": {},
          "inputs": {
            "failedAction": "@{coalesce(first(result('Scope_Try_Main'))?['name'], 'Scope_Try_Main')}",
            "errorMessage": "@{coalesce(first(result('Scope_Try_Main'))?['error']?['message'], 'Flow failed')}",
            "errorCode": "@{coalesce(first(result('Scope_Try_Main'))?['error']?['code'], 'FlowFailed')}",
            "errorDetail": "@{string(result('Scope_Try_Main'))}"
          }
        },
        "Compose_FlowRunUrl": {
          "type": "Compose",
          "runAfter": {
            "Compose_Error_Context": [
              "Succeeded"
            ]
          },
          "inputs": "@{replace(replace(replace(variables('FlowRunUrlTemplate'), '{environmentId}', coalesce(workflow()?['tags']?['environmentName'], '')), '{flowId}', coalesce(workflow()?['name'], '')), '{runId}', coalesce(workflow()?['run']?['name'], ''))}"
        },
        "Invoke_Log_Flow_Exception": {
          "type": "Workflow",
          "runAfter": {
            "Compose_FlowRunUrl": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "workflowReferenceName": "Child_Log_Flow_Exception"
            },
            "body": {
              "Origin": 1,
              "FlowDisplayName": "@{variables('FlowDisplayName')}",
              "FailedAction": "@{outputs('Compose_Error_Context')?['failedAction']}",
              "ErrorMessage": "@{outputs('Compose_Error_Context')?['errorMessage']}",
              "ErrorCode": "@{outputs('Compose_Error_Context')?['errorCode']}",
              "ErrorDetail": "@{outputs('Compose_Error_Context')?['errorDetail']}",
              "FlowRunId": "@{workflow()?['run']?['name']}",
              "FlowRunUrl": "@{outputs('Compose_FlowRunUrl')}",
              "CorrelationId": "@{variables('CorrelationId')}",
              "SubjectTable": "",
              "SubjectId": "",
              "Severity": 2
            }
          }
        },
        "Terminate_Failed": {
          "type": "Terminate",
          "runAfter": {
            "Invoke_Log_Flow_Exception": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "@{outputs('Compose_Error_Context')?['errorCode']}",
              "message": "@{outputs('Compose_Error_Context')?['errorMessage']}"
            }
          }
        }
      }
    },
    "Respond_to_Parent": {
      "type": "Response",
      "kind": "PowerApp",
      "runAfter": {
        "Scope_Try_Main": [
          "Succeeded",
          "Failed",
          "TimedOut",
          "Skipped"
        ]
      },
      "inputs": {
        "statusCode": 200,
        "body": {
          "ok": true
        },
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
