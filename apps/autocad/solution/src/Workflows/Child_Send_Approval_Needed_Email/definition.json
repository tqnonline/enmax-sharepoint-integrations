{
  "schemaVersion": "1.0.0.0",
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "RecipientEmail": {
              "type": "string"
            },
            "RecipientDisplayName": {
              "type": "string"
            },
            "ReservationId": {
              "type": "string"
            },
            "RequesterDisplayName": {
              "type": "string"
            },
            "CompositionPreview": {
              "type": "string"
            },
            "Count": {
              "type": "string"
            },
            "Reason": {
              "type": "string"
            },
            "OverrideText": {
              "type": "string"
            },
            "DeepLink": {
              "type": "string"
            },
            "Cc": {
              "type": "string"
            }
          },
          "required": [
            "RecipientEmail",
            "ReservationId"
          ]
        }
      }
    }
  },
  "actions": {
    "Get_Template": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "webresourceset",
          "$filter": "name eq 'enmax_approval_needed'",
          "$top": 1
        }
      }
    },
    "Substitute_Template": {
      "type": "Compose",
      "runAfter": {
        "Get_Template": [
          "Succeeded"
        ]
      },
      "inputs": "@{replace(replace(replace(replace(replace(replace(replace(replace(replace(base64ToString(outputs('Get_Template')?['body/value'][0]?['content']), '{{ReservationId}}', triggerBody()?['ReservationId']), '{{RequesterDisplayName}}', replace(replace(triggerBody()?['RequesterDisplayName'], '<', '&lt;'), '>', '&gt;')), '{{CompositionPreview}}', replace(replace(triggerBody()?['CompositionPreview'], '<', '&lt;'), '>', '&gt;')), '{{Count}}', triggerBody()?['Count']), '{{Reason}}', replace(replace(triggerBody()?['Reason'], '<', '&lt;'), '>', '&gt;')), '{{OverrideText}}', replace(replace(triggerBody()?['OverrideText'], '<', '&lt;'), '>', '&gt;')), '{{DeepLink}}', triggerBody()?['DeepLink']), '{{ApproveUrl}}', triggerBody()?['DeepLink']), '{{DeclineUrl}}', triggerBody()?['DeepLink'])}"
    },
    "Get_Shared_Mailbox": {
      "type": "OpenApiConnection",
      "runAfter": {
        "Substitute_Template": [
          "Succeeded"
        ]
      },
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadappconfigs",
          "$filter": "enmax_acdnkey eq 'SharedMailboxAddress'",
          "$top": 1
        }
      }
    },
    "Send_Email": {
      "type": "OpenApiConnection",
      "runAfter": {
        "Get_Shared_Mailbox": [
          "Succeeded"
        ]
      },
      "inputs": {
        "host": {
          "connectionName": "shared_office365",
          "operationId": "SharedMailboxSendEmailV2",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
        },
        "parameters": {
          "emailMessage/MailboxAddress": "@{outputs('Get_Shared_Mailbox')?['body/value'][0]?['enmax_acdnvalue']}",
          "emailMessage/To": "@{triggerBody()?['RecipientEmail']}",
          "emailMessage/Cc": "@{coalesce(triggerBody()?['Cc'], '')}",
          "emailMessage/Subject": "Reservation pending: @{triggerBody()?['ReservationId']}: @{triggerBody()?['CompositionPreview']}",
          "emailMessage/Body": "@{outputs('Substitute_Template')}",
          "emailMessage/Importance": "Normal"
        }
      },
      "retryPolicy": {
        "type": "fixed",
        "count": 1,
        "interval": "PT30S"
      }
    },
    "Respond_to_Parent": {
      "type": "Response",
      "kind": "PowerApp",
      "runAfter": {
        "Send_Email": [
          "Succeeded",
          "Failed",
          "TimedOut",
          "Skipped"
        ]
      },
      "inputs": {
        "statusCode": 200,
        "body": {
          "ok": true
        },
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
