{
  "schemaVersion": "1.0.0.0",
  "actions": {
    "Get_App_Config_SharedMailbox": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadappconfigs",
          "$filter": "enmax_acdnkey eq 'SharedMailboxAddress'",
          "$top": 1
        }
      }
    },
    "Initialize_RequesterContext": {
      "type": "InitializeVariable",
      "runAfter": {
        "Get_App_Config_SharedMailbox": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "RequesterDisplayName",
            "type": "string",
            "value": "@{triggerOutputs()?['body/_createdby_value@OData.Community.Display.V1.FormattedValue']}"
          }
        ]
      }
    },
    "Get_Business_Row": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadbusinesses",
          "recordId": "@{triggerOutputs()?['body/_enmax_acdnbusiness_value']}"
        }
      },
      "runAfter": {
        "Initialize_RequesterContext": [
          "Succeeded"
        ]
      }
    },
    "Get_Asset_Row": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadassets",
          "recordId": "@{triggerOutputs()?['body/_enmax_acdnasset_value']}"
        }
      },
      "runAfter": {
        "Get_Business_Row": [
          "Succeeded"
        ]
      }
    },
    "Get_Unit_Row": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadunits",
          "recordId": "@{triggerOutputs()?['body/_enmax_acdnunit_value']}"
        }
      },
      "runAfter": {
        "Get_Asset_Row": [
          "Succeeded"
        ]
      }
    },
    "Get_Domain_Row": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocaddomains",
          "recordId": "@{triggerOutputs()?['body/_enmax_acdndomain_value']}"
        }
      },
      "runAfter": {
        "Get_Unit_Row": [
          "Succeeded"
        ]
      }
    },
    "Get_System_Row": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadsystems",
          "recordId": "@{triggerOutputs()?['body/_enmax_acdnsystem_value']}"
        }
      },
      "runAfter": {
        "Get_Domain_Row": [
          "Succeeded"
        ]
      }
    },
    "Get_Kind_Row": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadkinds",
          "recordId": "@{triggerOutputs()?['body/_enmax_acdnkind_value']}"
        }
      },
      "runAfter": {
        "Get_System_Row": [
          "Succeeded"
        ]
      }
    },
    "Compose_Preview": {
      "type": "Compose",
      "runAfter": {
        "Get_Kind_Row": [
          "Succeeded"
        ]
      },
      "inputs": "@{outputs('Get_Business_Row')?['body/enmax_acdncode']}-@{outputs('Get_Asset_Row')?['body/enmax_acdncode']}-@{outputs('Get_Unit_Row')?['body/enmax_acdncode']}-@{outputs('Get_Domain_Row')?['body/enmax_acdncode']}-@{outputs('Get_System_Row')?['body/enmax_acdncode']}-@{outputs('Get_Kind_Row')?['body/enmax_acdncode']}-????"
    },
    "Get_DocControl_Config": {
      "type": "OpenApiConnection",
      "runAfter": {
        "Compose_Preview": [
          "Succeeded"
        ]
      },
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadappconfigs",
          "$filter": "enmax_acdnkey eq 'DocControlEmailAddress'",
          "$top": 1
        }
      }
    },
    "Get_CodeApp_BaseUrl_Config": {
      "type": "OpenApiConnection",
      "runAfter": {
        "Get_DocControl_Config": [
          "Succeeded"
        ]
      },
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadappconfigs",
          "$filter": "enmax_acdnkey eq 'CodeAppBaseUrl'",
          "$top": 1
        }
      }
    },
    "Get_Requester_User": {
      "type": "OpenApiConnection",
      "runAfter": {
        "Get_CodeApp_BaseUrl_Config": [
          "Succeeded"
        ]
      },
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "GetItem",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "systemusers",
          "recordId": "@{triggerOutputs()?['body/_createdby_value']}"
        }
      }
    },
    "Send_Approval_Email_To_DocControl": {
      "type": "Workflow",
      "runAfter": {
        "Get_Requester_User": [
          "Succeeded"
        ]
      },
      "inputs": {
        "host": {
          "workflowReferenceName": "Child_Send_Approval_Needed_Email"
        },
        "body": {
          "RecipientEmail": "@{outputs('Get_DocControl_Config')?['body/value'][0]?['enmax_acdnvalue']}",
          "RecipientDisplayName": "Document Control",
          "ReservationId": "@{triggerOutputs()?['body/enmax_acdnreservationnumber']}",
          "RequesterDisplayName": "@{variables('RequesterDisplayName')}",
          "CompositionPreview": "@{outputs('Compose_Preview')}",
          "Count": "@{triggerOutputs()?['body/enmax_acdndrawingcount']}",
          "Reason": "@{triggerOutputs()?['body/enmax_acdnreason']}",
          "OverrideText": "@{if(triggerOutputs()?['body/enmax_acdnoverride'], concat('Yes: ', triggerOutputs()?['body/enmax_acdnoverridereason']), 'No')}",
          "DeepLink": "@{concat(outputs('Get_CodeApp_BaseUrl_Config')?['body/value'][0]?['enmax_acdnvalue'], '/approvals')}",
          "Cc": ""
        }
      }
    }
  },
  "triggers": {
    "When_Reservation_Created": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 1,
          "subscriptionRequest/entityname": "enmax_autocadreservation",
          "subscriptionRequest/scope": 4,
          "subscriptionRequest/filterexpression": "enmax_acdnstatus eq 1"
        }
      },
      "metadata": {
        "description": "When a Reservation row is added with Status=Pending"
      }
    }
  }
}
