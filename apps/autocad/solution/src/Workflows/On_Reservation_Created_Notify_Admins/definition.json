{
  "schemaVersion": "1.0.0.0",
  "actions": {
    "trigger": {
      "type": "OpenApiConnectionWebhook",
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 1,
          "subscriptionRequest/entityname": "enmax_autocadreservation",
          "subscriptionRequest/scope": 4,
          "subscriptionRequest/filterexpression": "enmax_acdnstatus eq 1"
        }
      },
      "metadata": {
        "description": "When a Reservation row is added with Status=Pending"
      }
    },
    "Get_App_Config_SharedMailbox": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadappconfigs",
          "$filter": "enmax_acdnkey eq 'SharedMailboxAddress'",
          "$top": 1
        }
      }
    },
    "Initialize_RequesterContext": {
      "type": "InitializeVariable",
      "runAfter": { "Get_App_Config_SharedMailbox": ["Succeeded"] },
      "inputs": {
        "variables": [
          {
            "name": "RequesterDisplayName",
            "type": "string",
            "value": "@{triggerOutputs()?['body/_createdby_value@OData.Community.Display.V1.FormattedValue']}"
          }
        ]
      }
    },
    "Get_Related_Segments": {
      "type": "Parallel",
      "runAfter": { "Initialize_RequesterContext": ["Succeeded"] },
      "branches": {
        "Get_Business": {
          "actions": {
            "Get_Business_Row": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "enmax_autocadbusinesses",
                  "recordId": "@{triggerOutputs()?['body/_enmax_acdnbusiness_value']}"
                }
              }
            }
          }
        },
        "Get_Asset": {
          "actions": {
            "Get_Asset_Row": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "enmax_autocadassets",
                  "recordId": "@{triggerOutputs()?['body/_enmax_acdnasset_value']}"
                }
              }
            }
          }
        },
        "Get_Unit": {
          "actions": {
            "Get_Unit_Row": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "enmax_autocadunits",
                  "recordId": "@{triggerOutputs()?['body/_enmax_acdnunit_value']}"
                }
              }
            }
          }
        },
        "Get_Domain": {
          "actions": {
            "Get_Domain_Row": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "enmax_autocaddomains",
                  "recordId": "@{triggerOutputs()?['body/_enmax_acdndomain_value']}"
                }
              }
            }
          }
        },
        "Get_System": {
          "actions": {
            "Get_System_Row": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "enmax_autocadsystems",
                  "recordId": "@{triggerOutputs()?['body/_enmax_acdnsystem_value']}"
                }
              }
            }
          }
        },
        "Get_Kind": {
          "actions": {
            "Get_Kind_Row": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "enmax_autocadkinds",
                  "recordId": "@{triggerOutputs()?['body/_enmax_acdnkind_value']}"
                }
              }
            }
          }
        }
      }
    },
    "Compose_Preview": {
      "type": "Compose",
      "runAfter": { "Get_Related_Segments": ["Succeeded"] },
      "inputs": "@{outputs('Get_Business_Row')?['body/enmax_acdncode']}-@{outputs('Get_Asset_Row')?['body/enmax_acdncode']}-@{outputs('Get_Unit_Row')?['body/enmax_acdncode']}-@{outputs('Get_Domain_Row')?['body/enmax_acdncode']}-@{outputs('Get_System_Row')?['body/enmax_acdncode']}-@{outputs('Get_Kind_Row')?['body/enmax_acdncode']}-????"
    },
    "List_Admin_And_Approver_Members": {
      "type": "Parallel",
      "runAfter": { "Compose_Preview": ["Succeeded"] },
      "branches": {
        "List_Admin_Members": {
          "actions": {
            "List_Admin_Team_Members": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "teammemberships",
                  "$filter": "_teamid_value eq '@{outputs('Get_App_Config_SharedMailbox')?['body/value'][0]?['enmax_acdnvalue']}'",
                  "$select": "systemuserid,internalemailaddress,fullname"
                }
              }
            }
          }
        },
        "List_Approver_Members": {
          "actions": {
            "List_Approver_Team_Members": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "teammemberships",
                  "$select": "systemuserid,internalemailaddress,fullname"
                }
              }
            }
          }
        }
      }
    },
    "For_Each_Recipient": {
      "type": "Foreach",
      "runAfter": { "List_Admin_And_Approver_Members": ["Succeeded"] },
      "foreach": "@union(outputs('List_Admin_Team_Members')?['body/value'], outputs('List_Approver_Team_Members')?['body/value'])",
      "actions": {
        "Check_InApp_Notification_Exists": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadinappnotifications",
              "$filter": "_enmax_acdnrecipient_value eq '@{items('For_Each_Recipient')?['systemuserid']}' and _enmax_acdnsubjectreservation_value eq '@{triggerOutputs()?['body/enmax_acdnreservationid']}' and enmax_acdnsourceevent eq 9",
              "$top": 1
            }
          }
        },
        "Create_InApp_Notification_If_Not_Exists": {
          "type": "If",
          "runAfter": { "Check_InApp_Notification_Exists": ["Succeeded"] },
          "expression": {
            "equals": ["@length(outputs('Check_InApp_Notification_Exists')?['body/value'])", 0]
          },
          "actions": {
            "Create_InApp_Notification": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "enmax_autocadinappnotifications",
                  "item/enmax_acdntitle": "Reservation pending: @{triggerOutputs()?['body/enmax_acdnreservationnumber']}",
                  "item/enmax_acdnbody": "@{variables('RequesterDisplayName')} requested @{triggerOutputs()?['body/enmax_acdndrawingcount']} drawing(s): @{outputs('Compose_Preview')}",
                  "item/enmax_acdnseverity": 2,
                  "item/enmax_acdnsourceevent": 9,
                  "item/enmax_acdnsubjecttable": "enmax_autocadreservation",
                  "item/enmax_acdnsubjectid": "@{triggerOutputs()?['body/enmax_acdnreservationid']}",
                  "item/enmax_acdndeeplinkpath": "approvals/@{triggerOutputs()?['body/enmax_acdnreservationid']}",
                  "item/enmax_acdnread": false,
                  "item/enmax_acdnrecipient@odata.bind": "/systemusers(@{items('For_Each_Recipient')?['systemuserid']})",
                  "item/enmax_acdnsubjectreservation@odata.bind": "/enmax_autocadreservations(@{triggerOutputs()?['body/enmax_acdnreservationid']})"
                }
              }
            }
          },
          "else": { "actions": {} }
        },
        "Send_Approval_Needed_Email_Child": {
          "type": "Workflow",
          "runAfter": { "Create_InApp_Notification_If_Not_Exists": ["Succeeded", "Skipped"] },
          "inputs": {
            "host": {
              "workflowReferenceName": "Child_Send_Approval_Needed_Email"
            },
            "body": {
              "RecipientEmail":       "@{items('For_Each_Recipient')?['internalemailaddress']}",
              "RecipientDisplayName": "@{items('For_Each_Recipient')?['fullname']}",
              "ReservationId":        "@{triggerOutputs()?['body/enmax_acdnreservationnumber']}",
              "RequesterDisplayName": "@{variables('RequesterDisplayName')}",
              "CompositionPreview":   "@{outputs('Compose_Preview')}",
              "Count":                "@{triggerOutputs()?['body/enmax_acdndrawingcount']}",
              "Reason":               "@{triggerOutputs()?['body/enmax_acdnreason']}",
              "OverrideText":         "@{if(triggerOutputs()?['body/enmax_acdnoverride'], concat('Yes: ', triggerOutputs()?['body/enmax_acdnoverridereason']), 'No')}",
              "DeepLink":             "@{concat(outputs('Get_App_Config_SharedMailbox')?['body/value'][0]?['enmax_acdnvalue'], '#/approvals/', triggerOutputs()?['body/enmax_acdnreservationid'])}"
            }
          }
        },
        "Post_Teams_Adaptive_Card": {
          "type": "OpenApiConnectionWebhook",
          "runAfter": { "Send_Approval_Needed_Email_Child": ["Succeeded", "Failed"] },
          "inputs": {
            "host": {
              "connectionName": "shared_teams",
              "operationId": "PostAdaptiveCardAndWaitForAResponse",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
            },
            "parameters": {
              "poster": "Flow bot",
              "location": "Chat with Flow bot",
              "body/recipient": "@{items('For_Each_Recipient')?['internalemailaddress']}",
              "body/messageBody": "@{string(outputs('Load_Adaptive_Card_Template'))}",
              "body/updateMessage": "Your response was received.",
              "body/shouldUpdateCard": true
            }
          }
        },
        "Handle_Teams_Response": {
          "type": "If",
          "runAfter": { "Post_Teams_Adaptive_Card": ["Succeeded"] },
          "expression": {
            "equals": ["@body('Post_Teams_Adaptive_Card')?['data/verb']", "approve"]
          },
          "actions": {
            "Invoke_Approve_From_Teams": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformBoundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "enmax_autocadreservations",
                  "recordId": "@{triggerOutputs()?['body/enmax_acdnreservationid']}",
                  "actionName": "Microsoft.Dynamics.CRM.enmax_acdnApproveReservation",
                  "item/Decision": 2
                }
              }
            }
          },
          "else": {
            "actions": {
              "Invoke_Decline_From_Teams": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "PerformBoundAction",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "enmax_autocadreservations",
                    "recordId": "@{triggerOutputs()?['body/enmax_acdnreservationid']}",
                    "actionName": "Microsoft.Dynamics.CRM.enmax_acdnApproveReservation",
                    "item/Decision": 3,
                    "item/Reason": "@{body('Post_Teams_Adaptive_Card')?['data/declineReason']}"
                  }
                }
              }
            }
          }
        }
      }
    },
    "Log_Audit_Event_Created": {
      "type": "OpenApiConnection",
      "runAfter": { "For_Each_Recipient": ["Succeeded"] },
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "CreateRecord",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadauditevents",
          "item/enmax_acdnevent": 1,
          "item/enmax_acdnsource": 2,
          "item/enmax_acdnsubjectreservation@odata.bind": "/enmax_autocadreservations(@{triggerOutputs()?['body/enmax_acdnreservationid']})"
        }
      }
    }
  },
  "triggers": {
    "When_Reservation_Created": {
      "type": "OpenApiConnectionWebhook",
      "metadata": {
        "description": "Trigger-level filter: Status=Pending (1)"
      }
    }
  }
}
