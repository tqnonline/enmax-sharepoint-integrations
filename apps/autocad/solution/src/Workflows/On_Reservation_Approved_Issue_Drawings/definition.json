{
  "schemaVersion": "1.0.0.0",
  "triggers": {
    "When_Reservation_Updated_Approved": {
      "type": "OpenApiConnectionWebhook",
      "metadata": {
        "description": "Trigger filter: Status=Approved(2) AND modifiedby ne service-account-id — prevents loop (Finding 5.5)"
      },
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 3,
          "subscriptionRequest/entityname": "enmax_autocadreservation",
          "subscriptionRequest/scope": 4,
          "subscriptionRequest/filterexpression": "enmax_acdnstatus eq 2 and _modifiedby_value ne '@{parameters('ServiceAccountUserId')}'"
        }
      }
    }
  },
  "actions": {
    "Pre_Validate_Sequence_Capacity": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadnumbersequences",
          "$filter": "enmax_acdnsequencekey eq '@{triggerOutputs()?['body/enmax_acdnsequencekey']}'",
          "$select": "enmax_acdnlastissued,enmax_acdnstatus",
          "$top": 1
        }
      }
    },
    "Check_Capacity": {
      "type": "If",
      "runAfter": { "Pre_Validate_Sequence_Capacity": ["Succeeded"] },
      "expression": {
        "greater": [
          "@add(int(outputs('Pre_Validate_Sequence_Capacity')?['body/value'][0]?['enmax_acdnlastissued']), int(triggerOutputs()?['body/enmax_acdndrawingcount']))",
          9999
        ]
      },
      "actions": {
        "Revert_To_Pending_Capacity_Exceeded": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadreservations",
              "recordId": "@{triggerOutputs()?['body/enmax_acdnreservationid']}",
              "item/enmax_acdnstatus": 1,
              "item/enmax_acdnreason": "@{concat(triggerOutputs()?['body/enmax_acdnreason'], ' [REVERT: sequence capacity exceeded]')}"
            }
          }
        },
        "Terminate_Capacity_Exceeded": {
          "type": "Terminate",
          "runAfter": { "Revert_To_Pending_Capacity_Exceeded": ["Succeeded"] },
          "inputs": { "runStatus": "Succeeded" }
        }
      },
      "else": { "actions": {} }
    },
    "Get_Related_Segments_Approved": {
      "type": "Parallel",
      "runAfter": { "Check_Capacity": ["Succeeded"] },
      "metadata": {
        "description": "Fetch the six segment codes to feed the concurrency-safe enmax_acdnIssueNumbers action. ADR 0001 #4: no Asset-Unit combination lookup/gate."
      },
      "branches": {
        "Get_Business": { "actions": { "Get_Business_Row": { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "GetItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "enmax_autocadbusinesses", "recordId": "@{triggerOutputs()?['body/_enmax_acdnbusiness_value']}" } } } } },
        "Get_Asset":    { "actions": { "Get_Asset_Row":    { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "GetItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "enmax_autocadassets",    "recordId": "@{triggerOutputs()?['body/_enmax_acdnasset_value']}"    } } } } },
        "Get_Unit":     { "actions": { "Get_Unit_Row":     { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "GetItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "enmax_autocadunits",     "recordId": "@{triggerOutputs()?['body/_enmax_acdnunit_value']}"     } } } } },
        "Get_Domain":   { "actions": { "Get_Domain_Row":   { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "GetItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "enmax_autocaddomains",   "recordId": "@{triggerOutputs()?['body/_enmax_acdndomain_value']}"   } } } } },
        "Get_System":   { "actions": { "Get_System_Row":   { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "GetItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "enmax_autocadsystems",   "recordId": "@{triggerOutputs()?['body/_enmax_acdnsystem_value']}"   } } } } },
        "Get_Kind":     { "actions": { "Get_Kind_Row":     { "type": "OpenApiConnection", "inputs": { "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "GetItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" }, "parameters": { "entityName": "enmax_autocadkinds",     "recordId": "@{triggerOutputs()?['body/_enmax_acdnkind_value']}"     } } } } }
      }
    },
    "Invoke_IssueNumbers": {
      "type": "OpenApiConnection",
      "runAfter": { "Get_Related_Segments_Approved": ["Succeeded"] },
      "metadata": {
        "description": "Sole authoritative issuer (ADR 0001 #5, CLAUDE.md Rule 14): optimistic-lock concurrency guard in the enmax_acdnIssueNumbers plug-in."
      },
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "PerformUnboundAction",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "actionName": "enmax_acdnIssueNumbers",
          "item/BusinessCode": "@{outputs('Get_Business_Row')?['body/enmax_acdncode']}",
          "item/AssetCode":    "@{outputs('Get_Asset_Row')?['body/enmax_acdncode']}",
          "item/UnitCode":     "@{outputs('Get_Unit_Row')?['body/enmax_acdncode']}",
          "item/DomainCode":   "@{outputs('Get_Domain_Row')?['body/enmax_acdncode']}",
          "item/SystemCode":   "@{outputs('Get_System_Row')?['body/enmax_acdncode']}",
          "item/KindCode":     "@{outputs('Get_Kind_Row')?['body/enmax_acdncode']}",
          "item/Count":        "@{int(triggerOutputs()?['body/enmax_acdndrawingcount'])}"
        }
      }
    },
    "Parse_IssuedNumbers": {
      "type": "ParseJson",
      "runAfter": { "Invoke_IssueNumbers": ["Succeeded"] },
      "inputs": {
        "content": "@outputs('Invoke_IssueNumbers')?['body/IssuedNumbers']",
        "schema": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "Update_Reservation_IssuedNumbers": {
      "type": "OpenApiConnection",
      "runAfter": { "Parse_IssuedNumbers": ["Succeeded"] },
      "metadata": {
        "description": "Writing enmax_acdnissuednumbers fires the AutoCreateDrawings plug-in, which is the single, type-aware creator of Drawing/Document + child records (ADR 0001 #1/#5). The flow no longer creates drawings or sheets."
      },
      "inputs": {
        "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "UpdateRecord", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
        "parameters": {
          "entityName": "enmax_autocadreservations",
          "recordId": "@{triggerOutputs()?['body/enmax_acdnreservationid']}",
          "item/enmax_acdnissuednumbers": "@{string(body('Parse_IssuedNumbers'))}"
        }
      }
    },
    "Notify_Requester_Approved": {
      "type": "Workflow",
      "runAfter": { "Update_Reservation_IssuedNumbers": ["Succeeded"] },
      "inputs": {
        "host": { "workflowReferenceName": "Child_Send_Approval_Result_Email" },
        "body": {
          "RecipientEmail":           "@{triggerOutputs()?['body/_createdby_value@OData.Community.Display.V1.FormattedValue']}",
          "Decision":                 "Approved",
          "ReservationId":            "@{triggerOutputs()?['body/enmax_acdnreservationnumber']}",
          "IssuedNumbersFormatted":   "@{join(body('Parse_IssuedNumbers'), ', ')}",
          "SharePointLibraryUrl":     ""
        }
      }
    },
    "Log_Audit_Approval_Granted": {
      "type": "OpenApiConnection",
      "runAfter": { "Notify_Requester_Approved": ["Succeeded", "Failed"] },
      "inputs": {
        "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "CreateRecord", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
        "parameters": {
          "entityName": "enmax_autocadauditevents",
          "item/enmax_acdnevent": 2,
          "item/enmax_acdnsource": 2,
          "item/enmax_acdnsubjectreservation@odata.bind": "/enmax_autocadreservations(@{triggerOutputs()?['body/enmax_acdnreservationid']})"
        }
      }
    }
  }
}
