{
  "schemaVersion": "1.0.0.0",
  "triggers": {
    "When_Reservation_Updated_Approved": {
      "type": "OpenApiConnectionWebhook",
      "metadata": {
        "description": "Trigger filter: Status=Approved(2) AND modifiedby ne service-account-id \u2014 prevents loop (Finding 5.5)"
      },
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "SubscribeWebhookTrigger",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "subscriptionRequest/message": 3,
          "subscriptionRequest/entityname": "enmax_autocadreservation",
          "subscriptionRequest/scope": 4,
          "subscriptionRequest/filterexpression": "enmax_acdnstatus eq 2"
        }
      }
    }
  },
  "actions": {
    "Initialize_CorrelationId": {
      "type": "InitializeVariable",
      "runAfter": {},
      "inputs": {
        "variables": [
          {
            "name": "CorrelationId",
            "type": "string",
            "value": "@{coalesce(triggerBody()?['CorrelationId'], guid())}"
          }
        ]
      }
    },
    "Initialize_FlowDisplayName": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialize_CorrelationId": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "FlowDisplayName",
            "type": "string",
            "value": "Enmax AutoCAD | On Update of Reservation | Issue Drawing Numbers When Approved"
          }
        ]
      }
    },
    "Initialize_FlowRunUrlTemplate": {
      "type": "InitializeVariable",
      "runAfter": {
        "Initialize_FlowDisplayName": [
          "Succeeded"
        ]
      },
      "inputs": {
        "variables": [
          {
            "name": "FlowRunUrlTemplate",
            "type": "string",
            "value": "https://make.powerautomate.com/environments/{environmentId}/flows/{flowId}/runs/{runId}"
          }
        ]
      }
    },
    "Scope_Try_Main": {
      "type": "Scope",
      "runAfter": {
        "Initialize_FlowRunUrlTemplate": [
          "Succeeded"
        ]
      },
      "actions": {
        "Pre_Validate_Sequence_Capacity": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadnumbersequences",
              "$filter": "enmax_acdnsequencekey eq '@{triggerOutputs()?['body/enmax_acdnsequencekey']}'",
              "$select": "enmax_acdnlastissued,enmax_acdnstatus",
              "$top": 1
            }
          }
        },
        "Check_Capacity": {
          "type": "If",
          "runAfter": {
            "Pre_Validate_Sequence_Capacity": [
              "Succeeded"
            ]
          },
          "expression": {
            "greater": [
              "@add(int(outputs('Pre_Validate_Sequence_Capacity')?['body/value'][0]?['enmax_acdnlastissued']), int(triggerOutputs()?['body/enmax_acdndrawingcount']))",
              9999
            ]
          },
          "actions": {
            "Revert_To_Pending_Capacity_Exceeded": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "enmax_autocadreservations",
                  "recordId": "@{triggerOutputs()?['body/enmax_acdnreservationid']}",
                  "item/enmax_acdnstatus": 1,
                  "item/enmax_acdnreason": "@{concat(triggerOutputs()?['body/enmax_acdnreason'], ' [REVERT: sequence capacity exceeded]')}"
                }
              }
            },
            "Terminate_Capacity_Exceeded": {
              "type": "Terminate",
              "runAfter": {
                "Revert_To_Pending_Capacity_Exceeded": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Get_Business_Row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadbusinesses",
              "recordId": "@{triggerOutputs()?['body/_enmax_acdnbusiness_value']}"
            }
          },
          "runAfter": {
            "Check_Capacity": [
              "Succeeded"
            ]
          }
        },
        "Get_Asset_Row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadassets",
              "recordId": "@{triggerOutputs()?['body/_enmax_acdnasset_value']}"
            }
          },
          "runAfter": {
            "Get_Business_Row": [
              "Succeeded"
            ]
          }
        },
        "Get_Unit_Row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadunits",
              "recordId": "@{triggerOutputs()?['body/_enmax_acdnunit_value']}"
            }
          },
          "runAfter": {
            "Get_Asset_Row": [
              "Succeeded"
            ]
          }
        },
        "Get_Domain_Row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocaddomains",
              "recordId": "@{triggerOutputs()?['body/_enmax_acdndomain_value']}"
            }
          },
          "runAfter": {
            "Get_Unit_Row": [
              "Succeeded"
            ]
          }
        },
        "Get_System_Row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadsystems",
              "recordId": "@{triggerOutputs()?['body/_enmax_acdnsystem_value']}"
            }
          },
          "runAfter": {
            "Get_Domain_Row": [
              "Succeeded"
            ]
          }
        },
        "Get_Kind_Row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadkinds",
              "recordId": "@{triggerOutputs()?['body/_enmax_acdnkind_value']}"
            }
          },
          "runAfter": {
            "Get_System_Row": [
              "Succeeded"
            ]
          }
        },
        "Invoke_IssueNumbers": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Get_Kind_Row": [
              "Succeeded"
            ]
          },
          "metadata": {
            "description": "Sole authoritative issuer (ADR 0001 #5, CLAUDE.md Rule 14): optimistic-lock concurrency guard in the enmax_acdnIssueNumbers plug-in."
          },
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "PerformUnboundAction",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "actionName": "enmax_acdnIssueNumbers",
              "item/Business": "@{outputs('Get_Business_Row')?['body/enmax_acdncode']}",
              "item/Asset": "@{outputs('Get_Asset_Row')?['body/enmax_acdncode']}",
              "item/Unit": "@{outputs('Get_Unit_Row')?['body/enmax_acdncode']}",
              "item/Domain": "@{outputs('Get_Domain_Row')?['body/enmax_acdncode']}",
              "item/System": "@{outputs('Get_System_Row')?['body/enmax_acdncode']}",
              "item/Kind": "@{outputs('Get_Kind_Row')?['body/enmax_acdncode']}",
              "item/Count": "@{int(triggerOutputs()?['body/enmax_acdndrawingcount'])}",
              "item/Reservation": "@{triggerOutputs()?['body/enmax_acdnreservationid']}"
            }
          }
        },
        "Parse_IssuedNumbers": {
          "type": "ParseJson",
          "runAfter": {
            "Invoke_IssueNumbers": [
              "Succeeded"
            ]
          },
          "inputs": {
            "content": "@outputs('Invoke_IssueNumbers')?['body/IssuedNumbers']",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        },
        "Update_Reservation_IssuedNumbers": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Parse_IssuedNumbers": [
              "Succeeded"
            ]
          },
          "metadata": {
            "description": "Writing enmax_acdnissuednumbers fires the AutoCreateDrawings plug-in, which is the single, type-aware creator of Drawing/Document + child records (ADR 0001 #1/#5). The flow no longer creates drawings or sheets."
          },
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadreservations",
              "recordId": "@{triggerOutputs()?['body/enmax_acdnreservationid']}",
              "item/enmax_acdnissuednumbers": "@{string(body('Parse_IssuedNumbers'))}"
            }
          }
        },
        "Get_DocControl_Email": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Update_Reservation_IssuedNumbers": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadappconfigs",
              "$filter": "enmax_acdnkey eq 'DocControlEmailAddress'",
              "$top": 1
            }
          }
        },
        "Get_Requester_User": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Update_Reservation_IssuedNumbers": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "systemusers",
              "recordId": "@{triggerOutputs()?['body/_createdby_value']}"
            }
          }
        },
        "Get_CodeApp_BaseUrl_Config": {
          "type": "OpenApiConnection",
          "runAfter": {
            "Update_Reservation_IssuedNumbers": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "enmax_autocadappconfigs",
              "$filter": "enmax_acdnkey eq 'CodeAppBaseUrl'",
              "$top": 1
            }
          }
        },
        "Compose_TypeNoun": {
          "type": "Compose",
          "runAfter": {
            "Get_Requester_User": [
              "Succeeded"
            ]
          },
          "inputs": "@{toLower(coalesce(triggerOutputs()?['body/enmax_acdnreservationtype@OData.Community.Display.V1.FormattedValue'], 'Drawing'))}"
        },
        "Notify_Requester_Approved": {
          "type": "Workflow",
          "runAfter": {
            "Get_DocControl_Email": [
              "Succeeded"
            ],
            "Compose_TypeNoun": [
              "Succeeded"
            ],
            "Get_CodeApp_BaseUrl_Config": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "workflowReferenceName": "Child_Send_Approval_Result_Email"
            },
            "body": {
              "RecipientEmail": "@{outputs('Get_Requester_User')?['body/internalemailaddress']}",
              "Decision": "Approved",
              "ReservationId": "@{triggerOutputs()?['body/enmax_acdnreservationnumber']}",
              "TypeNoun": "@{outputs('Compose_TypeNoun')}",
              "RequesterDisplayName": "@{outputs('Get_Requester_User')?['body/fullname']}",
              "IssuedNumbersFormatted": "@{join(body('Parse_IssuedNumbers'), ', ')}",
              "SharePointLibraryUrl": "",
              "DeepLink": "@{concat(outputs('Get_CodeApp_BaseUrl_Config')?['body/value'][0]?['enmax_acdnvalue'], '?target=reservation&id=', triggerOutputs()?['body/enmax_autocadreservationid'])}",
              "Cc": "@{outputs('Get_DocControl_Email')?['body/value'][0]?['enmax_acdnvalue']}",
              "CorrelationId": "@{variables('CorrelationId')}"
            }
          }
        }
      }
    },
    "Scope_Catch_Failure": {
      "type": "Scope",
      "runAfter": {
        "Scope_Try_Main": [
          "Failed",
          "TimedOut"
        ]
      },
      "actions": {
        "Compose_Error_Context": {
          "type": "Compose",
          "runAfter": {},
          "inputs": {
            "failedAction": "@{coalesce(first(result('Scope_Try_Main'))?['name'], 'Scope_Try_Main')}",
            "errorMessage": "@{coalesce(first(result('Scope_Try_Main'))?['error']?['message'], 'Flow failed')}",
            "errorCode": "@{coalesce(first(result('Scope_Try_Main'))?['error']?['code'], 'FlowFailed')}",
            "errorDetail": "@{string(result('Scope_Try_Main'))}"
          }
        },
        "Compose_FlowRunUrl": {
          "type": "Compose",
          "runAfter": {
            "Compose_Error_Context": [
              "Succeeded"
            ]
          },
          "inputs": "@{replace(replace(replace(variables('FlowRunUrlTemplate'), '{environmentId}', coalesce(workflow()?['tags']?['environmentName'], '')), '{flowId}', coalesce(workflow()?['name'], '')), '{runId}', coalesce(workflow()?['run']?['name'], ''))}"
        },
        "Invoke_Log_Flow_Exception": {
          "type": "Workflow",
          "runAfter": {
            "Compose_FlowRunUrl": [
              "Succeeded"
            ]
          },
          "inputs": {
            "host": {
              "workflowReferenceName": "Child_Log_Flow_Exception"
            },
            "body": {
              "Origin": 1,
              "FlowDisplayName": "@{variables('FlowDisplayName')}",
              "FailedAction": "@{outputs('Compose_Error_Context')?['failedAction']}",
              "ErrorMessage": "@{outputs('Compose_Error_Context')?['errorMessage']}",
              "ErrorCode": "@{outputs('Compose_Error_Context')?['errorCode']}",
              "ErrorDetail": "@{outputs('Compose_Error_Context')?['errorDetail']}",
              "FlowRunId": "@{workflow()?['run']?['name']}",
              "FlowRunUrl": "@{outputs('Compose_FlowRunUrl')}",
              "CorrelationId": "@{variables('CorrelationId')}",
              "SubjectTable": "enmax_autocadreservation",
              "SubjectId": "@{triggerOutputs()?['body/enmax_autocadreservationid']}",
              "Severity": 2
            }
          }
        },
        "Terminate_Failed": {
          "type": "Terminate",
          "runAfter": {
            "Invoke_Log_Flow_Exception": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "@{outputs('Compose_Error_Context')?['errorCode']}",
              "message": "@{outputs('Compose_Error_Context')?['errorMessage']}"
            }
          }
        }
      }
    }
  }
}
