{
  "schemaVersion": "1.0.0.0",
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "enmax_autocadconrefSharePoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "metadata": {
        "description": "WS5e UAT harness: deletes seeded ~1KB test PDFs from UAT SharePoint libraries. Run after Validate or to reset the scenario matrix."
      },
      "triggers": {
        "Manual_Teardown": {
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "files": {
                  "type": "string",
                  "title": "JSON array of {libraryUrl,folderPath,fileName} entries to delete"
                }
              },
              "required": [
                "files"
              ]
            }
          }
        }
      },
      "actions": {
        "Apply_to_each_File": {
          "type": "Foreach",
          "runAfter": {},
          "foreach": "@json(triggerBody()?['files'])",
          "actions": {
            "Delete_File": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "DeleteFile",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@{items('Apply_to_each_File')?['libraryUrl']}",
                  "id": "@{concat(items('Apply_to_each_File')?['folderPath'], '/', items('Apply_to_each_File')?['fileName'])}"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          }
        },
        "Response": {
          "type": "Response",
          "runAfter": {
            "Apply_to_each_File": [
              "Succeeded",
              "Failed"
            ]
          },
          "kind": "Http",
          "inputs": {
            "statusCode": 200,
            "body": {
              "status": "teardown-complete"
            }
          }
        }
      }
    },
    "templateName": ""
  }
}
