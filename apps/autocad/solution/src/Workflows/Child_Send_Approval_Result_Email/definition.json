{
  "schemaVersion": "1.0.0.0",
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "PowerAppV2",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "RecipientEmail":         { "type": "string" },
            "Decision":               { "type": "string", "enum": ["Approved", "Declined"] },
            "ReservationId":          { "type": "string" },
            "IssuedNumbersFormatted": { "type": "string" },
            "SharePointLibraryUrl":   { "type": "string" },
            "DeclineReason":          { "type": "string" },
            "ApproverDisplayName":    { "type": "string" }
          },
          "required": ["RecipientEmail", "Decision", "ReservationId"]
        }
      }
    }
  },
  "actions": {
    "Choose_Template": {
      "type": "Switch",
      "runAfter": {},
      "expression": "@triggerBody()?['Decision']",
      "cases": {
        "Approved": {
          "case": "Approved",
          "actions": {
            "Get_Approved_Template": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "GetItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                "parameters": { "entityName": "webresourceset", "$filter": "name eq 'enmax_approval_approved'" }
              }
            },
            "Substitute_Approved": {
              "type": "Compose",
              "runAfter": { "Get_Approved_Template": ["Succeeded"] },
              "inputs": "@{replace(replace(replace(replace(base64ToString(outputs('Get_Approved_Template')?['body/content']), '{{ReservationId}}', triggerBody()?['ReservationId']), '{{IssuedNumbersFormatted}}', triggerBody()?['IssuedNumbersFormatted']), '{{SharePointLibraryUrl}}', triggerBody()?['SharePointLibraryUrl']), '{{ApproverDisplayName}}', replace(replace(triggerBody()?['ApproverDisplayName'], '<', '&lt;'), '>', '&gt;'))}"
            },
            "Send_Approved_Email": {
              "type": "OpenApiConnection",
              "runAfter": { "Substitute_Approved": ["Succeeded"] },
              "inputs": {
                "host": { "connectionName": "shared_office365", "operationId": "SendEmailFromSharedMailbox_V2", "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365" },
                "parameters": {
                  "MailboxAddress": "@parameters('SharedMailboxAddress')",
                  "To": "@{triggerBody()?['RecipientEmail']}",
                  "Subject": "Approved: @{triggerBody()?['ReservationId']}: @{triggerBody()?['IssuedNumbersFormatted']}",
                  "Body": "@{outputs('Substitute_Approved')}",
                  "IsHtml": true,
                  "Importance": "Normal"
                }
              },
              "retryPolicy": { "type": "fixed", "count": 1, "interval": "PT30S" }
            }
          }
        },
        "Declined": {
          "case": "Declined",
          "actions": {
            "Get_Declined_Template": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "shared_commondataserviceforapps", "operationId": "GetItem", "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps" },
                "parameters": { "entityName": "webresourceset", "$filter": "name eq 'enmax_approval_declined'" }
              }
            },
            "Substitute_Declined": {
              "type": "Compose",
              "runAfter": { "Get_Declined_Template": ["Succeeded"] },
              "inputs": "@{replace(replace(replace(base64ToString(outputs('Get_Declined_Template')?['body/content']), '{{ReservationId}}', triggerBody()?['ReservationId']), '{{DeclineReason}}', replace(replace(triggerBody()?['DeclineReason'], '<', '&lt;'), '>', '&gt;')), '{{ApproverDisplayName}}', replace(replace(triggerBody()?['ApproverDisplayName'], '<', '&lt;'), '>', '&gt;'))}"
            },
            "Send_Declined_Email": {
              "type": "OpenApiConnection",
              "runAfter": { "Substitute_Declined": ["Succeeded"] },
              "inputs": {
                "host": { "connectionName": "shared_office365", "operationId": "SendEmailFromSharedMailbox_V2", "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365" },
                "parameters": {
                  "MailboxAddress": "@parameters('SharedMailboxAddress')",
                  "To": "@{triggerBody()?['RecipientEmail']}",
                  "Subject": "Declined: @{triggerBody()?['ReservationId']}",
                  "Body": "@{outputs('Substitute_Declined')}",
                  "IsHtml": true,
                  "Importance": "Normal"
                }
              },
              "retryPolicy": { "type": "fixed", "count": 1, "interval": "PT30S" }
            }
          }
        }
      },
      "default": { "actions": {} }
    }
  }
}
