{
  "schemaVersion": "1.0.0.0",
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "RecipientEmail": {
              "type": "string"
            },
            "Decision": {
              "type": "string",
              "enum": [
                "Approved",
                "Declined"
              ]
            },
            "ReservationId": {
              "type": "string"
            },
            "IssuedNumbersFormatted": {
              "type": "string"
            },
            "SharePointLibraryUrl": {
              "type": "string"
            },
            "DeclineReason": {
              "type": "string"
            },
            "ApproverDisplayName": {
              "type": "string"
            },
            "Cc": {
              "type": "string"
            }
          },
          "required": [
            "RecipientEmail",
            "Decision",
            "ReservationId"
          ]
        }
      }
    }
  },
  "actions": {
    "Get_Shared_Mailbox": {
      "type": "OpenApiConnection",
      "runAfter": {},
      "inputs": {
        "host": {
          "connectionName": "shared_commondataserviceforapps",
          "operationId": "ListRecords",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
        },
        "parameters": {
          "entityName": "enmax_autocadappconfigs",
          "$filter": "enmax_acdnkey eq 'SharedMailboxAddress'",
          "$top": 1
        }
      }
    },
    "Choose_Template": {
      "type": "Switch",
      "runAfter": {
        "Get_Shared_Mailbox": [
          "Succeeded"
        ]
      },
      "expression": "@triggerBody()?['Decision']",
      "cases": {
        "Approved": {
          "case": "Approved",
          "actions": {
            "Get_Approved_Template": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "webresourceset",
                  "$filter": "name eq 'enmax_approval_approved'",
                  "$top": 1
                }
              }
            },
            "Substitute_Approved": {
              "type": "Compose",
              "runAfter": {
                "Get_Approved_Template": [
                  "Succeeded"
                ]
              },
              "inputs": "@{replace(replace(replace(replace(base64ToString(outputs('Get_Approved_Template')?['body/value'][0]?['content']), '{{ReservationId}}', triggerBody()?['ReservationId']), '{{IssuedNumbersFormatted}}', triggerBody()?['IssuedNumbersFormatted']), '{{SharePointLibraryUrl}}', triggerBody()?['SharePointLibraryUrl']), '{{ApproverDisplayName}}', replace(replace(triggerBody()?['ApproverDisplayName'], '<', '&lt;'), '>', '&gt;'))}"
            },
            "Send_Approved_Email": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Substitute_Approved": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@{outputs('Get_Shared_Mailbox')?['body/value'][0]?['enmax_acdnvalue']}",
                  "emailMessage/To": "@{triggerBody()?['RecipientEmail']}",
                  "emailMessage/Cc": "@{coalesce(triggerBody()?['Cc'], '')}",
                  "emailMessage/Subject": "Approved: @{triggerBody()?['ReservationId']}: @{triggerBody()?['IssuedNumbersFormatted']}",
                  "emailMessage/Body": "@{outputs('Substitute_Approved')}",
                  "emailMessage/Importance": "Normal"
                }
              },
              "retryPolicy": {
                "type": "fixed",
                "count": 1,
                "interval": "PT30S"
              }
            }
          }
        },
        "Declined": {
          "case": "Declined",
          "actions": {
            "Get_Declined_Template": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "webresourceset",
                  "$filter": "name eq 'enmax_approval_declined'",
                  "$top": 1
                }
              }
            },
            "Substitute_Declined": {
              "type": "Compose",
              "runAfter": {
                "Get_Declined_Template": [
                  "Succeeded"
                ]
              },
              "inputs": "@{replace(replace(replace(base64ToString(outputs('Get_Declined_Template')?['body/value'][0]?['content']), '{{ReservationId}}', triggerBody()?['ReservationId']), '{{DeclineReason}}', replace(replace(triggerBody()?['DeclineReason'], '<', '&lt;'), '>', '&gt;')), '{{ApproverDisplayName}}', replace(replace(triggerBody()?['ApproverDisplayName'], '<', '&lt;'), '>', '&gt;'))}"
            },
            "Send_Declined_Email": {
              "type": "OpenApiConnection",
              "runAfter": {
                "Substitute_Declined": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@{outputs('Get_Shared_Mailbox')?['body/value'][0]?['enmax_acdnvalue']}",
                  "emailMessage/To": "@{triggerBody()?['RecipientEmail']}",
                  "emailMessage/Cc": "@{coalesce(triggerBody()?['Cc'], '')}",
                  "emailMessage/Subject": "Declined: @{triggerBody()?['ReservationId']}",
                  "emailMessage/Body": "@{outputs('Substitute_Declined')}",
                  "emailMessage/Importance": "Normal"
                }
              },
              "retryPolicy": {
                "type": "fixed",
                "count": 1,
                "interval": "PT30S"
              }
            }
          }
        }
      },
      "default": {
        "actions": {}
      }
    },
    "Respond_to_Parent": {
      "type": "Response",
      "kind": "PowerApp",
      "runAfter": {
        "Choose_Template": [
          "Succeeded",
          "Failed",
          "TimedOut",
          "Skipped"
        ]
      },
      "inputs": {
        "statusCode": 200,
        "body": {
          "ok": true
        },
        "schema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
